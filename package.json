{
  "name": "discord-team-script",
  "version": "1.0.0",
  "main": "dist/test.js",
  "scripts": {
    "1": "tsc --importHelpers && node dist/test.js",
    "build": "tsc --importHelpers",
    "build:exe": "npm run build && pkg dist/test.js --targets node18-win-x64 --output test.exe"
  },
  "dependencies": {
    "@2captcha/captcha-solver": "^1.3.4",
    "@cemalgnlts/mailjs": "^3.0.1",
    "@faker-js/faker": "^9.8.0",
    "@hcaptcha/types": "^1.1.0",
    "axios": "^1.13.6",
    "https-proxy-agent": "^7.0.6",
    "imapflow": "^1.0.187",
    "langdetect": "^0.2.1",
    "mailparser": "^3.7.3",
    "p-limit": "^5.0.0",
    "patchright": "^1.52.1",
    "playwright": "^1.52.0",
    "socks-proxy-agent": "^8.0.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/imap-simple": "^4.2.10",
    "@types/imapflow": "^1.0.22",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.10",
    "pkg": "^5.8.1",
    "typescript": "^5.8.3"
  },
  "pkg": {
    "assets": [
      "data/**/*"
    ],
    "scripts": [
      "dist/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": ".",
    "nodePath": "node_modules"
  }
}
